APP_ENV=production
API_KEY=change-me-please
ADMIN_API_KEY=change-me-admin-please
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/rag
EMBED_DIM=384
EMBED_MODEL=storage/models/all-MiniLM-L6-v2
EMBED_OFFLINE=true
FAIL_ON_EMBEDDING_FALLBACK=true
STORAGE_RAW=storage/raw
STORAGE_PARSED=storage/parsed
RATE_LIMIT_PER_MINUTE=120
INGEST_PATH_MUST_BE_UNDER_STORAGE_RAW=true
UVICORN_WORKERS=2
VECTOR_RECALL_TOP_N=120
RERANK_TOP_N=40
RAG_FINAL_TOP_K=5
HYBRID_VECTOR_WEIGHT=0.6
QUERY_EXPANSION_ENABLED=true
DISABLE_MINERU_LLM=1
MINERU_PYTHON=/app/.venv-mineru/bin/python

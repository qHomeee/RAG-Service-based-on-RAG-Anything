APP_ENV=production
API_KEY=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-another-32-random-characters
ALLOWED_HOSTS=["rag.example.com","localhost","127.0.0.1"]

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-long-alphanumeric-password@postgres:5432/rag
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000

REDIS_URL=redis://redis:6379/0
REQUIRE_REDIS_IN_PRODUCTION=true
RATE_LIMIT_PER_MINUTE=60

EMBED_DIM=384
EMBED_MODEL=/app/storage/models/paraphrase-multilingual-MiniLM-L12-v2
EMBED_OFFLINE=true
EMBEDDING_BATCH_SIZE=32
FAIL_ON_EMBEDDING_FALLBACK=true
ENFORCE_EMBEDDING_MODEL_COMPATIBILITY=true
RERANKER_MODEL=/app/storage/models/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_OFFLINE=true
RERANKER_BACKEND=torch

UVICORN_WORKERS=2
UVICORN_LIMIT_CONCURRENCY=32
CPU_THREADS_PER_WORKER=3
CPU_INTEROP_THREADS=1
VECTOR_RECALL_TOP_N=60
VECTOR_SUBCHUNK_OVERSAMPLE=3
RERANK_TOP_N=12
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=256
RAG_FINAL_TOP_K=5
CONTEXT_EXPANSION_MAX_CHARS=1800
DEFAULT_MIN_SCORE=0.20

STORAGE_RAW=/app/storage/raw
STORAGE_PARSED=/app/storage/parsed
INGEST_PATH_MUST_BE_UNDER_STORAGE_RAW=true
MAX_FILE_SIZE_MB=128
MAX_INGEST_BATCH_MB=1000
MAX_INGEST_FILES=100
MINERU_PYTHON=/opt/venvs/mineru/bin/python
OCR_PREPROCESS_ENABLED=true
OCRMY_PDF_BINARY=ocrmypdf
OCR_LANGUAGES=rus+eng
OCR_JOBS=4
OCR_TIMEOUT_SECONDS=7200
OCR_SAMPLE_PAGES=12
OCR_MIN_CHARS_PER_SAMPLE_PAGE=80
MINERU_TIMEOUT_SECONDS=7200
DISABLE_MINERU_LLM=1

QUERY_EXPANSION_ENABLED=true
ALLOW_RETRIEVAL_DEBUG=false
AUTO_CREATE_SCHEMA=false
